<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for the PixieCore Blueprint demo module.
 */

/**
 * Implements hook_codemirror_mode_info_alter().
 */
function pixiecore_specification_codemirror_mode_info_alter(array &$modes): void {
  foreach (['javascript', 'yaml'] as $mode) {
    if (isset($modes[$mode])) {
      $modes[$mode]['usage'][] = 'pixiecore_specification';
    }
  }
}

/**
 * Implements hook_page_attachments().
 */
function pixiecore_specification_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'route';
  $attachments['#cache']['contexts'][] = 'theme';
  if (\Drupal::theme()->getActiveTheme()->getName() === 'claro' && in_array(\Drupal::routeMatch()->getRouteName(), ['user.login', 'pixiecore_specification.demo', 'pixiecore_specification.landing', 'pixiecore_specification.replay'], TRUE)) {
    $attachments['#attached']['library'][] = 'pixiecore_specification/dark';
  }
}

/**
 * Implements hook_theme().
 */
function pixiecore_specification_theme(): array {
  return [
    'pixiecore_demo_landing' => ['variables' => [], 'template' => 'pixiecore-demo-landing'],
    'pixiecore_demo_replay' => ['variables' => [], 'template' => 'pixiecore-demo-replay'],
  ];
}

/**
 * Implements hook_file_url_alter().
 *
 * Keeps replay assets on the path forwarded by the public site's proxy.
 */
function pixiecore_specification_file_url_alter(string &$uri): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'pixiecore_specification.replay'
    || !\Drupal\Core\Site\Settings::get('pixiecore_demo_replay_asset_prefix', FALSE)) {
    return;
  }
  // External URLs, stream wrappers, existing prefixes, and traversal stay out.
  if (!preg_match('@\A/?(?:core|modules|sites|libraries)/[a-zA-Z0-9_./-]+\z@', $uri)
    || preg_match('@(?:\A|/)\.@', $uri)) {
    return;
  }
  $uri = '/pixieagent/assets/' . ltrim($uri, '/');
}

/**
 * Implements hook_preprocess_html().
 */
function pixiecore_specification_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'pixiecore_specification.landing') {
    $variables['head_title']['title'] = 'PixieCore & PixieAgent demos';
  }
  if ($route === 'pixiecore_specification.replay') {
    $variables['head_title']['title'] = 'PixieAgent';
    // Claro's noscript links are head attachments outside the URL generator.
    foreach ($variables['page']['#attached']['html_head'] ?? [] as $index => $attachment) {
      $href = $attachment[0]['#attributes']['href'] ?? '';
      if (!is_string($href) || $href === '') {
        continue;
      }
      $parts = explode('?', $href, 2);
      $path = $parts[0];
      pixiecore_specification_file_url_alter($path);
      $variables['page']['#attached']['html_head'][$index][0]['#attributes']['href'] = $path
        . (isset($parts[1]) ? '?' . $parts[1] : '');
    }
  }
}
