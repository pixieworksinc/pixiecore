<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for the PixieCore Blueprint demo module.
 */

/**
 * Implements hook_codemirror_mode_info_alter().
 */
function pixiecore_specification_codemirror_mode_info_alter(array &$modes): void {
  foreach (['javascript', 'yaml'] as $mode) {
    if (isset($modes[$mode])) {
      $modes[$mode]['usage'][] = 'pixiecore_specification';
    }
  }
}

/**
 * Implements hook_page_attachments().
 */
function pixiecore_specification_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'route';
  $attachments['#cache']['contexts'][] = 'theme';
  if (\Drupal::theme()->getActiveTheme()->getName() === 'claro' && in_array(\Drupal::routeMatch()->getRouteName(), ['user.login', 'pixiecore_specification.demo'], TRUE)) {
    $attachments['#attached']['library'][] = 'pixiecore_specification/dark';
  }
}
