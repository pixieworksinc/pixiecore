  Assert<Compatible<typeof pixiecore.getLoggingConfig, ExpectedRootFunctionSignatures['getLoggingConfig']>>,
  Assert<Compatible<typeof pixiecore.getRuntimeEnvironment, ExpectedRootFunctionSignatures['getRuntimeEnvironment']>>,
  Assert<Compatible<typeof pixiecore.getTraceId, ExpectedRootFunctionSignatures['getTraceId']>>,
  Assert<Compatible<typeof pixiecore.isBuiltInProviderName, ExpectedRootFunctionSignatures['isBuiltInProviderName']>>,
  Assert<Compatible<typeof pixiecore.logExecutionComplete, ExpectedRootFunctionSignatures['logExecutionComplete']>>,
  Assert<Compatible<typeof pixiecore.logExecutionRetry, ExpectedRootFunctionSignatures['logExecutionRetry']>>,
  Assert<Compatible<typeof pixiecore.logExecutionStart, ExpectedRootFunctionSignatures['logExecutionStart']>>,
