type Equal<Left, Right> =
  (<Value>() => Value extends Left ? 1 : 2) extends
  (<Value>() => Value extends Right ? 1 : 2)
    ? (<Value>() => Value extends Right ? 1 : 2) extends
      (<Value>() => Value extends Left ? 1 : 2)
        ? true
        : false
    : false;
type Compatible<Current, LegacyContract> =
  Current extends LegacyContract ? true : false;
type Assert<Condition extends true> = Condition;

interface ExpectedRuntimeConfig {
  provider: ProviderName;
  temperature: number;
  maxRetry: number;
  requestTimeout: number;
  maxToolRounds: number;
  strictValidation: boolean;
  usePseudoToolCalling: boolean;
  maxPayloadSize: number;
  toolChoice?: ToolChoice;
  model?: string;
}

interface ExpectedRootFunctionSignatures {
  attachmentBytes: (
    attachment: ResolvedAttachment,
    fetcher?: typeof globalThis.fetch,
  ) => Promise<Uint8Array>;
  captureLogs: (logger?: pixiecore.PixieCoreLogger) => {
    readonly records: LogRecord[];
    close(): void;
    [Symbol.dispose](): void;
  };
  cleanGeminiSchema: (value: unknown) => unknown;
  configureLogging: (
    options?: LoggingOptions | pixiecore.LoggingConfig,
  ) => pixiecore.LoggingConfig;
  contentParts: (content: MessageContent) => MessageContentPart[];
  contentText: (content: MessageContent) => string;
  convertToolCallNames: (
    calls: ToolCall[],
    mapping: Map<string, string>,
  ) => ToolCall[];
  createProvider: (name: string, options?: RuntimeOptions) => Provider;
  enhanceMessagesWithMultimodal: (
    messages: readonly Message[],
    inputs: Readonly<Record<string, unknown>>,
    provider: Provider,
  ) => Message[];
  extractPdfText: (
    attachment: ResolvedAttachment,
    fetcher?: typeof globalThis.fetch,
  ) => Promise<string>;
  generateTraceId: () => string;
  getConfig: (
    overrides?: RuntimeOptions,
    environment?: NodeJS.ProcessEnv,
  ) => ExpectedRuntimeConfig;
  getLogger: (name?: string) => pixiecore.PixieCoreLogger;
  getLoggingConfig: (
    overrides?: RuntimeOptions,
    environment?: NodeJS.ProcessEnv,
  ) => pixiecore.LoggingConfig;
  getRuntimeEnvironment: (environment?: NodeJS.ProcessEnv) => NodeJS.ProcessEnv;
  getTraceId: () => string;
  isBuiltInProviderName: (name: string) => name is BuiltInProviderName;
  logExecutionComplete: (
    status: string,
    output: unknown,
    durationMs: number,
    errorCount?: number,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logExecutionRetry: (
    owner: 'runtime' | 'application' | 'host',
    reason: string,
    attempt: number,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logExecutionStart: (
    blueprint: string,
    inputs: unknown,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logLlmRequest: (
    provider: string,
    model: string,
    request: unknown,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logLlmResponse: (
    provider: string,
    model: string,
    response: unknown,
    durationMs: number,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logToolExecution: (
    tool: string,
    args: unknown,
    result: unknown,
    durationMs: number,
    error?: string | null,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  logValidationResult: (
    kind: string,
    passed: boolean,
    error?: string,
    logger?: pixiecore.PixieCoreLogger,
  ) => void;
  makeDataUrl: (mediaType: string, data: Uint8Array) => string;
  makeSafeToolName: (
    name: string,
    existing?: Set<string>,
    maxLength?: number,
  ) => string;
  mimeFromName: (name: string, kind: 'image' | 'file') => string;
  normalizeAttachmentInput: (
    value: unknown,
    name: 'image_path' | 'file_path',
  ) => string[];
  parseDataUrl: (value: string) => {
    mediaType: string;
    data: Uint8Array;
  } | undefined;
  resolveAttachment: (
    part: ImageContentPart | FileContentPart,
    fetcher?: typeof globalThis.fetch,
  ) => Promise<ResolvedAttachment>;
  runWithTraceId: <Value>(traceId: string, task: () => Value) => Value;
  sanitizeLogMessage: (message: string, options?: SanitizationOptions) => string;
  sanitizePayload: <Value>(payload: Value, options?: SanitizationOptions) => Value;
  sanitizeToolNames: (tools: ToolDefinition[]) => {
    tools: ToolDefinition[];
    mapping: Map<string, string>;
  };
  setTraceId: (traceId: string | null) => void;
  shouldUseAnthropicPdfTextFallback: (model: string) => boolean;
  truncatePayload: <Value>(payload: Value, maxSize?: number) => Value | TruncatedPayload;
}

