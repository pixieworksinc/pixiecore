interface ExpectedApiValueContracts {
  ApiError: new(type: string, message: string, status: number) => api.ApiError;
  createApp: (options?: ApiOptions) => PixieCoreApiServer;
  EXECUTE_REQUEST_SCHEMA: {
    readonly type: 'object';
    readonly required: readonly ['blueprint'];
    readonly properties: {
      readonly blueprint: { readonly type: 'string' };
      readonly inputs: { readonly type: 'object'; readonly additionalProperties: true };
      readonly messages: { readonly type: 'array' };
      readonly files: { readonly type: 'object'; readonly additionalProperties: false };
    };
    readonly additionalProperties: true;
  };
  mapApiError: (error: unknown) => api.ApiError;
  OPENAPI_DOCUMENT: {
    readonly openapi: '3.1.0';
    readonly info: {
      readonly title: 'PixieCore REST API';
      readonly version: string;
      readonly description: 'Execute PixieCore Blueprints over HTTP.';
    };
    readonly paths: {
      readonly '/health': unknown;
      readonly '/execute': unknown;
    };
  };
}

const apiValueContracts: ExpectedApiValueContracts = api;
type ApiExactContracts = readonly [
  Assert<Compatible<
    typeof api.ApiError,
    new(type: string, message: string, status: number) => api.ApiError
  >>,
  Assert<Equal<api.ApiError['type'], string>>,
  Assert<Equal<api.ApiError['status'], number>>,
  Assert<Compatible<typeof api.createApp, ExpectedApiValueContracts['createApp']>>,
  Assert<Compatible<typeof api.mapApiError, ExpectedApiValueContracts['mapApiError']>>,
  Assert<Equal<typeof api.EXECUTE_REQUEST_SCHEMA.type, 'object'>>,
  Assert<Equal<typeof api.EXECUTE_REQUEST_SCHEMA.required, readonly ['blueprint']>>,
  Assert<Equal<typeof api.EXECUTE_REQUEST_SCHEMA.additionalProperties, true>>,
  Assert<Equal<typeof api.OPENAPI_DOCUMENT.openapi, '3.1.0'>>,
  Assert<Equal<typeof api.OPENAPI_DOCUMENT.info.title, 'PixieCore REST API'>>,
  Assert<Equal<typeof api.OPENAPI_DOCUMENT.info.version, string>>,
  Assert<Equal<ApiOptions['pluginConfigPath'], string | 'disabled' | null | undefined>>,
];

const jsonPrimitive: JsonPrimitive = 'value';
const jsonValue: JsonValue = { nested: [jsonPrimitive, 1, true, null] };
const jsonObject: JsonObject = { value: jsonValue };
const inputType: InputType = 'file';
const inputPlaceholder: InputPlaceholder = {
  name: 'document',
  type: inputType,
  required: true,
  default: 'document.txt',
  description: 'Document to process',
};
const permissions: BlueprintPermissions = {
  allow_roles: ['assistant'],
  deny_roles: ['blocked'],
  allow_users: ['user'],
  deny_users: ['blocked-user'],
  allow_scopes: ['read'],
  deny_scopes: ['admin'],
};
const blueprint: Blueprint = {
  name: 'consumer',
  version: '1.0',
  role: 'assistant',
  prompt: 'Process {{ document }}',
  input_schema: {
    type: 'object',
    properties: { document: { type: 'string' } },
    required: ['document'],
  },
  output_schema: { type: 'object' },
  input_placeholders: [inputPlaceholder],
  localization: { en: 'Process {{ document }}' },
  permissions,
  examples: [{ input: { document: 'in' }, output: { result: 'out' } }],
  model: 'consumer-model',
  temperature: 0,
  tools: ['consumer_tool'],
};

const textPart: TextContentPart = { type: 'text', text: 'hello' };
const imagePart: ImageContentPart = {
  type: 'image',
  source: 'data:image/png;base64,AA==',
  mediaType: 'image/png',
  filename: 'image.png',
  detail: 'high',
};
const filePart: FileContentPart = {
  type: 'file',
  source: 'data:text/plain;base64,QQ==',
  mediaType: 'text/plain',
  filename: 'file.txt',
};
const contentPart: MessageContentPart = textPart;
const content: MessageContent = [contentPart, imagePart, filePart];
const systemMessage: SystemMessage = { role: 'system', content: 'system' };
const userMessage: UserMessage = { role: 'user', content };
const toolCall: ToolCall = {
  id: 'call-1',
  name: 'consumer_tool',
  arguments: { value: true },
  providerMetadata: { source: 'consumer' },
};
const assistantMessage: AssistantMessage = {
  role: 'assistant',
  content: 'assistant',
  toolCalls: [toolCall],
};
const toolMessage: ToolMessage = {
  role: 'tool',
  content: '{"ok":true}',
  toolCallId: toolCall.id,
  name: toolCall.name,
  isError: false,
};
const messages: readonly Message[] = [systemMessage, userMessage, assistantMessage, toolMessage];

const toolDefinition: ToolDefinition = {
  name: 'consumer_tool',
  description: 'A consumer tool',
  parameters: { type: 'object' },
};
const toolHandler: ToolHandler = async arguments_ => ({ arguments_ });
const registeredTool: RegisteredTool = { ...toolDefinition, execute: toolHandler };
const toolChoice: ToolChoice = 'auto';
const toolExecutionResult: ToolExecutionResult = {
  id: toolCall.id,
  name: toolCall.name,
  content: '{}',
  isError: false,
};
const generateRequest: GenerateRequest = {
  messages,
  schema: { type: 'object' },
  tools: [toolDefinition],
  toolChoice,
  model: 'consumer-model',
  temperature: 0,
  maxTokens: 64,
  signal: new AbortController().signal,
};
const generateResponse: GenerateResponse = {
  content: '{}',
  toolCalls: [toolCall],
  raw: { ok: true },
};
const provider: Provider = {
  name: 'consumer',
  model: 'consumer-model',
  supportsTools: true,
  supportsMultimodal: true,
  supportsVision: () => true,
  supportsFileInput: () => true,
  getModelList: async () => ['consumer-model'],
  generate: async request => ({ ...generateResponse, raw: request }),
  close: () => undefined,
};

const agentRoleResult: AgentRoleResult = { messages, model: 'consumer-model', temperature: 0 };
const agentRole: AgentRolePlugin = {
  supportedRoles: ['assistant'],
  apply: async (_renderedPrompt, _blueprint, _inputs) => agentRoleResult,
  close: () => undefined,
};
const decoratorStage: DecoratorStage = 'both';
const decoratorContext: DecoratorContext = {
  blueprint,
  inputs: { document: 'file.txt' },
  schema: { type: 'object' },
  provider,
  request: generateRequest,
  attempt: 1,
  output: jsonObject,
};
const outputDecorator: OutputDecorator = {
  priority: 100,
  stage: decoratorStage,
  validate: async context_ => context_,
  close: () => undefined,
};
const providerFactory: ProviderFactory = {
  name: 'consumer-factory',
  create: async () => provider,
  close: () => undefined,
};
const providerPlugin: ProviderPlugin = providerFactory;
const plugin: PixieCorePlugin = {
  agentRoles: [agentRole],
  decorators: [outputDecorator],
  tools: [registeredTool],
  providers: [providerPlugin],
  close: () => undefined,
};

const logLevel: LogLevel = 'INFO';
const loggingOptions: LoggingOptions = {
  logLevel,
  logToFile: false,
  logDir: 'logs',
  logFile: 'pixiecore.log',
  logMaxBytes: 1_024,
  logBackupCount: 1,
  auditFile: 'audit.log',
  auditMaxBytes: 1_024,
  auditBackupCount: 1,
  sanitizeCredentials: true,
  sensitiveFields: ['token'],
  customValuePatterns: ['secret'],
  logFullPayloads: false,
  maxPayloadSize: 1_024,
  logToConsole: false,
};
const sanitizationOptions: SanitizationOptions = {
  sensitiveFields: ['token'],
