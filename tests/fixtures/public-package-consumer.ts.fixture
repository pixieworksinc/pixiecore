const conformanceReportPromise: Promise<PopConformanceReport> =
  conformance.runPopConformanceSuite();
const conformanceGroup: PopConformanceGroup = 'runtime';
const conformanceCase: PopConformanceCaseResult = {
  id: 'consumer.runtime',
  group: conformanceGroup,
  passed: true,
};
void conformanceReportPromise;
void conformanceCase;

const instructionConformanceOptions: InstructionTemplateConformanceOptions = {};
const instructionConformanceReportPromise: Promise<InstructionTemplateConformanceReport> =
  conformance.runInstructionTemplateConformanceSuite(instructionConformanceOptions);
void instructionConformanceReportPromise;

