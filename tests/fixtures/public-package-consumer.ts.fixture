  Assert<Compatible<typeof pixiecore.logValidationResult, ExpectedRootFunctionSignatures['logValidationResult']>>,
  Assert<Compatible<typeof pixiecore.makeDataUrl, ExpectedRootFunctionSignatures['makeDataUrl']>>,
  Assert<Compatible<typeof pixiecore.makeSafeToolName, ExpectedRootFunctionSignatures['makeSafeToolName']>>,
  Assert<Compatible<typeof pixiecore.mimeFromName, ExpectedRootFunctionSignatures['mimeFromName']>>,
  Assert<Compatible<typeof pixiecore.normalizeAttachmentInput, ExpectedRootFunctionSignatures['normalizeAttachmentInput']>>,
  Assert<Compatible<typeof pixiecore.parseDataUrl, ExpectedRootFunctionSignatures['parseDataUrl']>>,
  Assert<Compatible<typeof pixiecore.resolveAttachment, ExpectedRootFunctionSignatures['resolveAttachment']>>,
  Assert<Compatible<typeof pixiecore.runWithTraceId, ExpectedRootFunctionSignatures['runWithTraceId']>>,
  Assert<Compatible<typeof pixiecore.sanitizeLogMessage, ExpectedRootFunctionSignatures['sanitizeLogMessage']>>,
  Assert<Compatible<typeof pixiecore.sanitizePayload, ExpectedRootFunctionSignatures['sanitizePayload']>>,
  Assert<Compatible<typeof pixiecore.sanitizeToolNames, ExpectedRootFunctionSignatures['sanitizeToolNames']>>,
  Assert<Compatible<typeof pixiecore.setTraceId, ExpectedRootFunctionSignatures['setTraceId']>>,
  Assert<Compatible<typeof pixiecore.shouldUseAnthropicPdfTextFallback, ExpectedRootFunctionSignatures['shouldUseAnthropicPdfTextFallback']>>,
