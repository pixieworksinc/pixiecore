{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.execution-telemetry-v1.schema.json",
  "title": "PixieCore execution telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "telemetry_id", "started_at", "duration_ms", "result", "units", "totals"],
  "properties": {
    "schema": { "const": "pixiecore.execution-telemetry/v1" },
    "telemetry_id": { "$ref": "#/$defs/nonBlankString" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "duration_ms": { "$ref": "#/$defs/nonNegativeNumber" },
    "result": { "$ref": "#/$defs/result" },
    "units": {
      "type": "array",
      "items": { "$ref": "#/$defs/unit" }
    },
    "totals": { "$ref": "#/$defs/totals" }
  },
  "$defs": {
    "nonBlankString": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "result": { "enum": ["succeeded", "failed", "cancelled"] },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/count" },
        "output_tokens": { "$ref": "#/$defs/count" },
        "total_tokens": { "$ref": "#/$defs/count" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": { "$ref": "#/$defs/nonBlankString" },
        "amount": { "$ref": "#/$defs/nonNegativeNumber" }
      }
    },
    "retries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "application", "host", "total"],
      "properties": {
        "runtime": { "$ref": "#/$defs/count" },
        "application": { "$ref": "#/$defs/count" },
        "host": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "providerUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "calls", "tokens", "cost", "cost_status"],
      "properties": {
        "provider": { "$ref": "#/$defs/nonBlankString" },
        "model": { "$ref": "#/$defs/nonBlankString" },
        "calls": { "$ref": "#/$defs/count" },
        "tokens": {
          "oneOf": [{ "$ref": "#/$defs/tokens" }, { "type": "null" }]
        },
        "cost": {
          "oneOf": [{ "$ref": "#/$defs/cost" }, { "type": "null" }]
        },
        "cost_status": { "enum": ["calculated", "missing_usage", "missing_pricing"] },
        "pricing_source": { "$ref": "#/$defs/nonBlankString" },
        "pricing_effective_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "cost_status": { "const": "calculated" } }, "required": ["cost_status"] },
          "then": {
            "required": ["pricing_source", "pricing_effective_at"],
            "properties": {
              "tokens": { "$ref": "#/$defs/tokens" },
              "cost": { "$ref": "#/$defs/cost" },
              "pricing_source": { "$ref": "#/$defs/nonBlankString" },
              "pricing_effective_at": { "$ref": "#/$defs/timestamp" }
            }
          },
          "else": {
            "properties": { "cost": { "type": "null" } }
          }
        },
        {
          "if": { "properties": { "cost_status": { "const": "missing_usage" } }, "required": ["cost_status"] },
          "then": { "properties": { "tokens": { "type": "null" } } }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_type",
        "unit_id",
        "blueprint_version",
        "started_at",
        "duration_ms",
        "result",
        "attempts",
        "retries",
        "failure_count",
        "error_codes",
        "provider_usage",
        "tokens",
        "token_complete",
        "costs",
        "cost_complete"
      ],
      "properties": {
        "unit_type": { "enum": ["blueprint", "node"] },
        "unit_id": { "$ref": "#/$defs/nonBlankString" },
        "blueprint_version": { "$ref": "#/$defs/nonBlankString" },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "duration_ms": { "$ref": "#/$defs/nonNegativeNumber" },
        "result": { "$ref": "#/$defs/result" },
        "attempts": { "type": "integer", "minimum": 1 },
        "retries": { "$ref": "#/$defs/retries" },
        "failure_count": { "$ref": "#/$defs/count" },
        "error_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlankString" }
        },
        "provider_usage": {
          "type": "array",
          "items": { "$ref": "#/$defs/providerUsage" }
        },
        "tokens": { "$ref": "#/$defs/tokens" },
        "token_complete": { "type": "boolean" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/cost" }
        },
        "cost_complete": { "type": "boolean" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_count",
        "attempts",
        "retries",
        "failure_count",
        "provider_calls",
        "tokens",
        "token_complete",
        "costs",
        "cost_complete"
      ],
      "properties": {
        "unit_count": { "$ref": "#/$defs/count" },
        "attempts": { "$ref": "#/$defs/count" },
        "retries": { "$ref": "#/$defs/retries" },
        "failure_count": { "$ref": "#/$defs/count" },
        "provider_calls": { "$ref": "#/$defs/count" },
        "tokens": { "$ref": "#/$defs/tokens" },
        "token_complete": { "type": "boolean" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/cost" }
        },
        "cost_complete": { "type": "boolean" }
      }
    }
  }
}
