{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.review-handoff-v1.schema.json",
  "title": "PixieCore human-review handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review_id", "trace_id", "created_at", "blueprint", "output"],
  "properties": {
    "schema": { "const": "pixiecore.review-handoff/v1" },
    "review_id": { "$ref": "#/$defs/nonBlankString" },
    "trace_id": { "$ref": "#/$defs/nonBlankString" },
    "created_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "blueprint": { "$ref": "#/$defs/blueprintReference" },
    "output": { "type": "object" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "blueprintReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonBlankString" },
        "version": { "$ref": "#/$defs/nonBlankString" },
        "role": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": { "$ref": "#/$defs/nonBlankString" },
        "message": { "$ref": "#/$defs/nonBlankString" },
        "severity": { "enum": ["info", "warning", "error"] },
        "path": { "$ref": "#/$defs/jsonPointer" }
      }
    }
  }
}
