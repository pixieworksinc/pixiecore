{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.blueprint-quality-catalog-v1.schema.json",
  "title": "PixieCore Blueprint quality catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "units"],
  "properties": {
    "schema": { "const": "pixiecore.blueprint-quality-catalog/v1" },
    "version": { "$ref": "#/$defs/semver" },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "model",
        "dataset",
        "score",
        "passed_cases",
        "total_cases",
        "runs",
        "evidence"
      ],
      "properties": {
        "kind": { "enum": ["offline_contract", "remote_provider"] },
        "provider": { "$ref": "#/$defs/text" },
        "model": { "$ref": "#/$defs/text" },
        "dataset": { "$ref": "#/$defs/dataset" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed_cases": { "type": "integer", "minimum": 0 },
        "total_cases": { "type": "integer", "minimum": 1 },
        "runs": { "type": "integer", "minimum": 1 },
        "evidence": { "$ref": "#/$defs/path" },
        "benchmark_artifact": { "$ref": "#/$defs/path" },
        "evidence_status": { "enum": ["current", "historical"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "remote_provider" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "benchmark_artifact": { "$ref": "#/$defs/path" }
            },
            "required": ["benchmark_artifact"]
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "blueprint_version", "license", "measurements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
        "blueprint_version": { "$ref": "#/$defs/semver" },
        "license": { "$ref": "#/$defs/text" },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/measurement" }
        }
      }
    }
  }
}
