{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.jit-promotions-v1.schema.json",
  "title": "PixieCore evidence-admitted JIT promotions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "note", "promotions"],
  "properties": {
    "schema": { "const": "pixiecore.jit-promotions/v1" },
    "note": { "$ref": "#/$defs/text" },
    "promotions": { "type": "array", "items": { "$ref": "#/$defs/promotion" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "semver": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint", "version", "model", "source_digest", "artifact_digest", "evidence", "program"],
      "properties": {
        "blueprint": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/semver" },
        "model": { "$ref": "#/$defs/text" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "artifact_digest": { "$ref": "#/$defs/digest" },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset_digest", "seed", "case_count", "run_count", "correct", "agreed", "measured_at"],
          "properties": {
            "dataset_digest": { "$ref": "#/$defs/digest" },
            "seed": { "$ref": "#/$defs/text" },
            "case_count": { "type": "integer", "minimum": 1 },
            "run_count": { "type": "integer", "minimum": 1 },
            "correct": { "type": "integer", "minimum": 1 },
            "agreed": { "type": "integer", "minimum": 1 },
            "measured_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
          }
        },
        "program": { "$ref": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.jit-program-v1.schema.json" }
      }
    }
  }
}
