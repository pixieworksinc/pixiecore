{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.provider-fallback-receipt-v1.schema.json",
  "title": "PixieCore provider fallback receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "policy_version",
    "fallback_used",
    "selected_target_id",
    "quality_drop",
    "attempts"
  ],
  "properties": {
    "schema": { "const": "pixiecore.provider-fallback-receipt/v1" },
    "policy_id": { "$ref": "#/$defs/nonBlankString" },
    "policy_version": { "$ref": "#/$defs/nonBlankString" },
    "fallback_used": { "type": "boolean" },
    "selected_target_id": {
      "oneOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }]
    },
    "quality_drop": {
      "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    }
  },
  "$defs": {
    "nonBlankString": { "type": "string", "pattern": ".*\\S.*" },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "provider",
        "model",
        "quality_score",
        "dataset_id",
        "dataset_version",
        "result"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/nonBlankString" },
        "provider": { "$ref": "#/$defs/nonBlankString" },
        "model": { "$ref": "#/$defs/nonBlankString" },
        "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "dataset_id": { "$ref": "#/$defs/nonBlankString" },
        "dataset_version": { "$ref": "#/$defs/nonBlankString" },
        "result": { "enum": ["succeeded", "failed"] },
        "error_code": { "$ref": "#/$defs/nonBlankString" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "failed" } }, "required": ["result"] },
          "then": {
            "properties": { "error_code": { "$ref": "#/$defs/nonBlankString" } },
            "required": ["error_code"]
          },
          "else": { "not": { "required": ["error_code"] } }
        }
      ]
    }
  }
}
