{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.instruction-template-conformance-v1.schema.json",
  "title": "PixieCore instruction-template conformance fixture v1",
  "type": "object",
  "required": [
    "schema",
    "canonical_syntax",
    "legacy_syntax",
    "portable_name_pattern",
    "render_cases",
    "validation_cases"
  ],
  "properties": {
    "schema": { "const": "pixiecore.instruction-template-conformance/v1" },
    "canonical_syntax": { "const": "{{ name }}" },
    "legacy_syntax": { "const": "{name}" },
    "portable_name_pattern": { "const": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "render_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/renderCase" }
    },
    "validation_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validationCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "renderCase": {
      "type": "object",
      "required": ["id", "template", "inputs", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "template": { "type": "string" },
        "inputs": { "type": "object" },
        "expected": { "type": "string" },
        "portable": { "type": "boolean", "default": true },
        "extension_id": { "$ref": "#/$defs/extensionId" }
      },
      "allOf": [{ "$ref": "#/$defs/extensionIdentity" }],
      "additionalProperties": false
    },
    "validationCase": {
      "type": "object",
      "required": ["id", "template", "declared_inputs", "expected_undeclared"],
      "properties": {
        "id": { "$ref": "#/$defs/caseId" },
        "template": { "type": "string" },
        "declared_inputs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "expected_undeclared": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "portable": { "type": "boolean", "default": true },
        "extension_id": { "$ref": "#/$defs/extensionId" }
      },
      "allOf": [{ "$ref": "#/$defs/extensionIdentity" }],
      "additionalProperties": false
    },
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*(?:/[a-z0-9][a-z0-9.-]*)$"
    },
    "extensionIdentity": {
      "if": {
        "type": "object",
        "required": ["portable"],
        "properties": { "portable": { "const": false } }
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": { "extension_id": {} },
          "required": ["extension_id"]
        }
      }
    }
  }
}
