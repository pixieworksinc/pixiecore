{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.signed-audit-export-v1.schema.json",
  "title":"PixieCore signed audit export v1",
  "type":"object","additionalProperties":false,
  "required":["schema","export_id","created_at","events","signature"],
  "properties":{
    "schema":{"const":"pixiecore.signed-audit-export/v1"},
    "export_id":{"type":"string","pattern":".*\\S.*"},
    "created_at":{"$ref":"#/$defs/time"},
    "events":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/event"}},
    "signature":{"type":"object","additionalProperties":false,"required":["algorithm","key_id","value"],"properties":{"algorithm":{"const":"Ed25519"},"key_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"value":{"type":"string","minLength":1}}}
  },
  "$defs":{
    "text":{"type":"string","pattern":".*\\S.*"},
    "time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "event":{"type":"object","additionalProperties":false,"required":["timestamp","trace_id","source","event","outcome"],"properties":{"timestamp":{"$ref":"#/$defs/time"},"trace_id":{"$ref":"#/$defs/text"},"source":{"$ref":"#/$defs/text"},"event":{"$ref":"#/$defs/text"},"outcome":{"enum":["succeeded","failed","cancelled","denied"]},"error_code":{"$ref":"#/$defs/text"}}}
  }
}
