{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.review-receipt-v1.schema.json",
  "title": "PixieCore human-review receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "trace_id",
    "handoff_digest",
    "decision",
    "reviewer_id",
    "decided_at"
  ],
  "properties": {
    "schema": { "const": "pixiecore.review-receipt/v1" },
    "review_id": { "$ref": "#/$defs/nonBlankString" },
    "trace_id": { "$ref": "#/$defs/nonBlankString" },
    "handoff_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": { "enum": ["approved", "rejected", "changes_requested"] },
    "reviewer_id": { "$ref": "#/$defs/nonBlankString" },
    "decided_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "comment": { "$ref": "#/$defs/nonBlankString" },
    "reviewed_output": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    }
  }
}
