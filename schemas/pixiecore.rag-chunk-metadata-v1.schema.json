{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pixieworksinc/pixiecore/0.1.x/schemas/pixiecore.rag-chunk-metadata-v1.schema.json",
  "title": "PixieCore portable RAG chunk metadata v1",
  "description": "Storage-neutral metadata for a retrievable chunk. Access and sensitivity values are application-defined policy labels, not authorization grants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "namespace",
    "chunk_type",
    "field",
    "version",
    "access_level",
    "sensitivity",
    "updated_at",
    "author"
  ],
  "properties": {
    "schema": { "const": "pixiecore.rag-chunk-metadata/v1" },
    "namespace": { "$ref": "#/$defs/nonBlankString" },
    "chunk_type": { "$ref": "#/$defs/nonBlankString" },
    "field": { "$ref": "#/$defs/nonBlankString" },
    "version": { "$ref": "#/$defs/nonBlankString" },
    "access_level": { "$ref": "#/$defs/nonBlankString" },
    "sensitivity": { "$ref": "#/$defs/nonBlankString" },
    "updated_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "author": { "$ref": "#/$defs/nonBlankString" },
    "attributes": { "type": "object" }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonicalTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    }
  }
}
