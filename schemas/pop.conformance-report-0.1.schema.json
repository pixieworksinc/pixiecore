{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pop:schema:conformance-report:0.1",
  "title": "POP Conformance Report 0.1",
  "description": "Value-free result of running one implementation against a POP Core 0.1 conformance suite.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite", "specification", "implementation", "profile", "capabilities", "summary", "cases", "conformant"],
  "properties": {
    "schema": { "const": "pop.conformance-report/0.1" },
    "suite": { "const": "pop.conformance-suite/0.1" },
    "specification": { "const": "pop-core/0.1" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonBlankString" },
        "version": { "$ref": "#/$defs/semanticVersion" }
      }
    },
    "profile": { "enum": ["validator", "runtime"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlankString" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "group": { "enum": ["validation", "comparison", "runtime", "capability"] },
          "passed": { "type": "boolean" }
        }
      }
    },
    "conformant": { "type": "boolean" }
  },
  "$defs": {
    "nonBlankString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
